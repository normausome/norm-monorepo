# All optional. Bun loads .env automatically; Railway injects PORT itself.

# Port the API listens on. Railway sets this; leave unset locally (defaults to 8787).
# PORT=8787

# Interface to bind. Default 0.0.0.0 (required on Railway). Use 127.0.0.1 to keep a
# local run off the network.
# HOST=0.0.0.0

# Comma-separated browser origins allowed to call /api cross-origin. Replaces the
# built-in list (dmvtolls.com, www.dmvtolls.com, localhost:5173/4173). "*" allows any.
# CORS_ORIGINS=https://dmvtolls.com,https://www.dmvtolls.com,http://localhost:5173

# --- Advanced mode (address → address). All optional; with nothing set it uses the
# --- public OSRM demo router and komoot's Photon geocoder, both keyless.

# Mapbox access token (pk. or sk.; it is only ever used server-side, never sent to the
# browser). When set, routing uses Mapbox Directions and geocoding uses Mapbox
# Geocoding v6 instead of the free demo services. Default token scopes are enough.
# MAPBOX_TOKEN=pk.…

# Any OSRM-compatible router (e.g. self-hosted OSRM) to use instead of the demo server.
# Ignored when MAPBOX_TOKEN is set.
# ROUTING_URL=https://router.project-osrm.org

# Alternative Photon geocoder instance. Ignored when MAPBOX_TOKEN is set.
# PHOTON_URL=https://photon.komoot.io
