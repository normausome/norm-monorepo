# All optional. Bun loads .env automatically; Railway injects PORT itself.

# Port the API listens on. Railway sets this; leave unset locally (defaults to 8787).
# PORT=8787

# Interface to bind. Default 0.0.0.0 (required on Railway). Use 127.0.0.1 to keep a
# local run off the network.
# HOST=0.0.0.0

# Comma-separated browser origins allowed to call /api cross-origin. Replaces the
# built-in list (dmvtolls.com, www.dmvtolls.com, localhost:5173/4173). "*" allows any.
# CORS_ORIGINS=https://dmvtolls.com,https://www.dmvtolls.com,http://localhost:5173
