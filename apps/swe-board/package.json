{
  "name": "swe-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:web": "vite",
    "dev:api": "bun --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "bun server/index.ts",
    "migrate": "bun db/migrate.ts",
