# Required by the server and the scraper. Bun loads .env automatically.
DATABASE_URL=postgresql://swe:swe@127.0.0.1:5432/swe_board

# Port the API listens on. Railway sets this. Default 8790.
# PORT=8790

# Interface to bind. Default 0.0.0.0.
# HOST=0.0.0.0

# Consecutive successful board scrapes without a job before it goes inactive. Default 3.
# MAX_MISSED_RUNS=3

# Used only by `bun test` to run the PgStore half of the store contract suite.
# TEST_DATABASE_URL=postgresql://swe:swe@127.0.0.1:5432/swe_board_test
